# ===================================================
# 환경 변수 예시 파일
# 이 파일을 복사하여 .env로 사용하세요
# cp .env.example .env
# ===================================================

# ─── Database (PostgreSQL) ───
# Docker Compose 사용 시: db 호스트는 서비스명 'db'
# 로컬 개발 시: localhost로 변경
DATABASE_URL="postgresql://artium:artium_secret_2024@localhost:5432/artium_gallery"

# ─── NextAuth ───
# 프로덕션에서는 실제 도메인으로 변경
NEXTAUTH_URL="http://localhost:3000"

# 프로덕션에서는 반드시 강력한 랜덤 키로 변경!
# openssl rand -base64 32 로 생성 가능
NEXTAUTH_SECRET="my-super-secret-key-change-in-production-2024"

# Docker 환경에서 필요
AUTH_TRUST_HOST="true"
